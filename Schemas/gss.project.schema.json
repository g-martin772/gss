{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://gss.local/schemas/gss.project.schema.json",
  "title": "GSS Project Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "versionNumber"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The project name."
    },
    "versionNumber": {
      "type": "string",
      "minLength": 1,
      "description": "The project config version number."
    }
  }
}